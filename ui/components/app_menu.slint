import { Theme } from "../theme.slint";

// Выпадающее меню (оверлей поверх всего окна, позиция — под верхней плашкой).
// Клик мимо карточки закрывает; клик по пункту закрывает и сообщает действие.
export component AppMenu inherits Rectangle {
    in-out property <bool> open: false;
    callback close();
    callback item(string);

    visible: root.open;
    background: transparent;

    // Прозрачная подложка во весь экран: любой клик мимо — закрыть.
    Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        TouchArea {
            clicked => { root.close(); }
        }
    }

    Rectangle {
        x: root.width - 222px;
        y: 56px;
        width: 210px;
        background: Theme.surface-raised;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border-strong;

        VerticalLayout {
            padding: Theme.space-1;
            spacing: 2px;
            for item in [
                { label: "Settings", action: "settings" },
                { label: "Debug", action: "debug" },
                { label: "Keyboard shortcuts", action: "help" },
                { label: "Reset view", action: "reset-view" },
            ] : Rectangle {
                height: 32px;
                border-radius: Theme.radius-sm;
                background: touch.pressed ? Theme.surface : transparent;
                touch := TouchArea {
                    clicked => { root.item(item.action); }
                    Text {
                        text: item.label;
                        color: Theme.text;
                        font-size: Theme.font-sm;
                        vertical-alignment: center;
                        x: Theme.space-2;
                    }
                }
            }
        }
    }
}