import { Theme } from "../theme.slint";
import { Toolbar } from "toolbar.slint";

// Центральная Bento-карточка: viewport холста (Render-to-Texture) + плавающая
// панель инструментов поверх него.
export component CanvasView inherits Rectangle {
    in-out property <image> canvas-texture;
    in-out property <bool> debug-show: false;
    in-out property <string> debug-text: "";
    in-out property <string> active-tool: "select";
    // Имя хэндла гизмо под курсором ("" — вне хэндлов); задаётся из Rust.
    in property <string> hovered-handle: "";

    // Фактический размер области холста (заполняется лейаутом).
    in-out property <float> canvas-width: canvas-area.width / 1px;
    in-out property <float> canvas-height: canvas-area.height / 1px;

    // Инлайн-редактирование текстового узла: оверлей-TextInput поверх холста.
    in-out property <bool> editing: false;
    in-out property <float> edit-x: 0;
    in-out property <float> edit-y: 0;
    in-out property <float> edit-w: 120;
    in-out property <float> edit-h: 24;
    in-out property <float> edit-font-size: 16;
    in-out property <color> edit-color: #e8e8e8;
    in-out property <string> edit-text: "";

    callback canvas-size-changed(float, float);
    callback pointer-down(int, float, float, bool, bool);
    callback pointer-move(int, float, float);
    callback pointer-up(int, float, float);
    callback scroll(float, float, float);
    callback tool-selected(string);
    // ПКМ отпущена: локальные координаты холста (контекстное меню открывается в Rust).
    callback context-menu(float, float);
    callback edit-text-changed(string);
    callback edit-finished();

    changed canvas-width => { root.canvas-size-changed(root.canvas-width, root.canvas-height); }
    changed canvas-height => { root.canvas-size-changed(root.canvas-width, root.canvas-height); }
    changed editing => {
        if (root.editing) {
            edit-input.focus();
        }
    }

    function btn(b: PointerEventButton) -> int {
        if (b == PointerEventButton.left) { return 1; }
        if (b == PointerEventButton.middle) { return 2; }
        return 3;
    }

    background: Theme.surface;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    canvas-area := Rectangle {
        background: Theme.canvas-bg;

        Image {
            width: 100%;
            height: 100%;
            source: root.canvas-texture;
            image-fit: fill;
            image-rendering: smooth;
        }

        TouchArea {
            mouse-cursor: root.hovered-handle == "nw" ? nwse-resize :
                root.hovered-handle == "se" ? nwse-resize :
                root.hovered-handle == "ne" ? nesw-resize :
                root.hovered-handle == "sw" ? nesw-resize :
                root.hovered-handle == "n" ? ns-resize :
                root.hovered-handle == "s" ? ns-resize :
                root.hovered-handle == "e" ? ew-resize :
                root.hovered-handle == "w" ? ew-resize :
                default;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.pointer-down(btn(event.button), self.mouse-x / 1px, self.mouse-y / 1px, event.modifiers.control, event.modifiers.alt);
                } else if (event.kind == PointerEventKind.up) {
                    if (event.button == PointerEventButton.right) {
                        root.context-menu(self.mouse-x / 1px, self.mouse-y / 1px);
                    } else {
                        root.pointer-up(btn(event.button), self.mouse-x / 1px, self.mouse-y / 1px);
                    }
                }
            }
            moved => {
                root.pointer-move(0, self.mouse-x / 1px, self.mouse-y / 1px);
            }
            scroll-event(event) => {
                root.scroll(event.delta-y / 1px, self.mouse-x / 1px, self.mouse-y / 1px);
                accept
            }
        }

        // Оверлей дебагера (ниже плавающей панели инструментов)
        if root.debug-show : Rectangle {
            x: Theme.space-2;
            y: 60px;
            width: 340px;
            height: 220px;
            background: Theme.surface;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border;
            Text {
                text: root.debug-text;
                color: Theme.text;
                font-family: "Consolas";
                font-size: Theme.font-xs;
                x: 10px;
                y: 10px;
                wrap: word-wrap;
            }
        }

        // Инлайн-редактор текстового узла: рамка в акцентном цвете поверх
        // отрисованного текста, внутри — прозрачный TextInput. Элемент всегда
        // существует (visible=false), чтобы id был доступен из корня.
        edit-overlay := Rectangle {
            visible: root.editing;
            x: root.edit-x * 1px;
            y: root.edit-y * 1px;
            width: root.edit-w * 1px;
            height: root.edit-h * 1px;
            background: Theme.canvas-bg;
            border-radius: 2px;
            border-width: 1px;
            border-color: Theme.accent;

            edit-input := TextInput {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                text: root.edit-text;
                color: root.edit-color;
                font-family: Theme.font-family;
                font-size: root.edit-font-size * 1px;
                horizontal-alignment: left;
                vertical-alignment: top;
                single-line: false;
                edited => { root.edit-text-changed(self.text); }
                accepted() => { root.edit-finished(); }
                key-pressed(event) => {
                    if (event.text == "escape") {
                        root.edit-finished();
                        accept
                    } else {
                        reject
                    }
                }
            }
        }
    }

    // Плавающая панель инструментов: по центру снизу, 20px от нижней кромки.
    // Ширина 284px захардкожена и должна совпадать с Toolbar (7 кнопок × 36px).
    Toolbar {
        x: (root.width - 284px) / 2;
        y: root.height - 44px - 20px;
        active-tool: root.active-tool;
        tool-selected(t) => { root.tool-selected(t); }
    }
}