import { Field, NumberField, SectionHeader } from "ds.slint";
import { Theme } from "../theme.slint";

// Правая панель: параметры выделенного узла (Bento-карточка).
// Commit полей — по Enter; тексты управляются из Rust (не затирают ввод).
export component Inspector inherits Rectangle {
    in-out property <bool> has-selection: false;
    in-out property <string> sel-name: "";
    in-out property <string> sel-x-text: "";
    in-out property <string> sel-y-text: "";
    in-out property <string> sel-w-text: "";
    in-out property <string> sel-h-text: "";
    in-out property <string> sel-opacity-text: "";
    in-out property <string> sel-fill: "";

    callback set-name(string);
    callback set-x(string);
    callback set-y(string);
    callback set-w(string);
    callback set-h(string);
    callback set-opacity(string);
    callback set-fill(string);

    background: Theme.surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-2;

        SectionHeader { caption: "Properties"; }

        VerticalLayout {
            visible: root.has-selection;
            spacing: Theme.space-2;

            Text {
                text: "Name";
                color: Theme.text-muted;
                font-size: Theme.font-xs;
            }
            Field {
                text: root.sel-name;
                accepted(t) => { root.set-name(t); }
            }

            Text {
                text: "Position";
                color: Theme.text-muted;
                font-size: Theme.font-xs;
            }
            NumberField {
                label: "X";
                value: root.sel-x-text;
                set-value(t) => { root.set-x(t); }
            }
            NumberField {
                label: "Y";
                value: root.sel-y-text;
                set-value(t) => { root.set-y(t); }
            }

            Text {
                text: "Size";
                color: Theme.text-muted;
                font-size: Theme.font-xs;
            }
            NumberField {
                label: "W";
                value: root.sel-w-text;
                set-value(t) => { root.set-w(t); }
            }
            NumberField {
                label: "H";
                value: root.sel-h-text;
                set-value(t) => { root.set-h(t); }
            }

            Text {
                text: "Opacity";
                color: Theme.text-muted;
                font-size: Theme.font-xs;
            }
            NumberField {
                label: "%";
                value: root.sel-opacity-text;
                set-value(t) => { root.set-opacity(t); }
            }

            Text {
                text: "Fill";
                color: Theme.text-muted;
                font-size: Theme.font-xs;
            }
            Field {
                text: root.sel-fill;
                accepted(t) => { root.set-fill(t); }
            }
        }

        Text {
            text: "Select a node";
            color: Theme.text-faint;
            font-size: Theme.font-sm;
            visible: !root.has-selection;
        }
    }
}