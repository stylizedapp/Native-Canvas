import { Field, NumberField, SectionHeader, Divider, ActionButton } from "ds.slint";
import { Theme } from "../theme.slint";

// Правая панель: параметры выделения (Bento-карточка).
// Commit полей — по Enter; тексты управляются из Rust (не затирают ввод).
// При мультивыделении X/Y/W/H показывают общую рамку группы (ввод = дельта),
// а свойства (Fill/Stroke/Opacity/Rotation/радиус) применяются ко всем.
export component Inspector inherits Rectangle {
    in-out property <bool> has-selection: false;
    // Текст-плейсхолдер при мультивыделении (приходит из Rust).
    in-out property <string> sel-hint: "";
    in-out property <string> sel-x-text: "";
    in-out property <string> sel-y-text: "";
    in-out property <string> sel-w-text: "";
    in-out property <string> sel-h-text: "";
    in-out property <string> sel-rot-text: "";
    in-out property <string> sel-opacity-text: "";
    in-out property <string> sel-fill: "";
    in-out property <color> sel-fill-preview: #00000000;
    in-out property <string> sel-stroke: "";
    in-out property <color> sel-stroke-preview: #00000000;
    in-out property <bool> sel-stroke-dash: false;
    in-out property <string> sel-stroke-width-text: "";
    in-out property <string> sel-corner-tl-text: "";
    in-out property <string> sel-corner-tr-text: "";
    in-out property <string> sel-corner-br-text: "";
    in-out property <string> sel-corner-bl-text: "";
    in-out property <string> sel-corner-text: "";
    in-out property <bool> sel-corner-expanded: false;
    in-out property <bool> is-frame: false;
    in-out property <bool> is-text: false;
    in-out property <string> sel-font-size-text: "";
    in-out property <int> sel-align: 0;
    in-out property <int> layout-mode: 0;
    in-out property <int> sel-layout-direction: 0;
    in-out property <int> sel-layout-align: 0;
    in-out property <int> sel-layout-justify: 0;
    in-out property <string> sel-layout-gap: "";
    in-out property <string> sel-layout-padding: "";

    callback live-x(string);
    callback live-y(string);
    callback live-w(string);
    callback live-h(string);
    callback live-rot(string);
    callback live-opacity(string);
    callback live-fill(string);
    callback live-stroke(string);
    callback live-stroke-width(string);
    callback live-corner(int, string);
    callback live-corner-uniform(string);
    callback scrub-corner-uniform(float);
    callback toggle-corner-expand();
    callback commit-field(int);
    callback open-picker();
    callback open-stroke-picker();
    callback toggle-stroke-dash();
    callback scrub-delta(int, float);
    callback set-layout-mode(int);
    callback set-layout-direction(int);
    callback set-layout-align(int);
    callback set-layout-justify(int);
    callback live-layout-gap(string);
    callback live-layout-padding(string);
    callback scrub-layout-gap(float);
    callback scrub-layout-padding(float);
    // Текст.
    callback live-font-size(string);
    callback set-text-align(int);

    background: Theme.surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-2;

        SectionHeader { caption: "Properties"; }

        VerticalLayout {
            visible: root.has-selection;
            spacing: Theme.space-2;

            Text {
                text: "Position & Rotation";
                color: Theme.text-muted;
                font-size: Theme.font-xs;
            }
            NumberField {
                label: "X";
                value: root.sel-x-text;
                edited(t) => { root.live-x(t); }
                set-value(t) => { root.live-x(t); root.commit-field(0); }
                scrubbed(d) => { root.scrub-delta(0, d); }
            }
            NumberField {
                label: "Y";
                value: root.sel-y-text;
                edited(t) => { root.live-y(t); }
                set-value(t) => { root.live-y(t); root.commit-field(1); }
                scrubbed(d) => { root.scrub-delta(1, d); }
            }
            NumberField {
                label: "°";
                value: root.sel-rot-text;
                edited(t) => { root.live-rot(t); }
                set-value(t) => { root.live-rot(t); root.commit-field(4); }
                scrubbed(d) => { root.scrub-delta(2, d); }
            }

            Divider {}

            Text {
                text: "Size";
                color: Theme.text-muted;
                font-size: Theme.font-xs;
            }
            NumberField {
                label: "W";
                value: root.sel-w-text;
                edited(t) => { root.live-w(t); }
                set-value(t) => { root.live-w(t); root.commit-field(2); }
                scrubbed(d) => { root.scrub-delta(3, d); }
            }
            NumberField {
                label: "H";
                value: root.sel-h-text;
                edited(t) => { root.live-h(t); }
                set-value(t) => { root.live-h(t); root.commit-field(3); }
                scrubbed(d) => { root.scrub-delta(4, d); }
            }

            // Параметры текста (только для Text-узла).
            VerticalLayout {
                visible: root.is-text;
                spacing: Theme.space-2;

                Divider {}

                Text {
                    text: "Text";
                    color: Theme.text-muted;
                    font-size: Theme.font-xs;
                }
                NumberField {
                    label: "Size";
                    value: root.sel-font-size-text;
                    edited(t) => { root.live-font-size(t); }
                    set-value(t) => { root.live-font-size(t); root.commit-field(16); }
                }
                HorizontalLayout {
                    spacing: Theme.space-1;
                    ActionButton { horizontal-stretch: 1; text: "L"; checked: root.sel-align == 0; clicked => { root.set-text-align(0); } }
                    ActionButton { horizontal-stretch: 1; text: "C"; checked: root.sel-align == 1; clicked => { root.set-text-align(1); } }
                    ActionButton { horizontal-stretch: 1; text: "R"; checked: root.sel-align == 2; clicked => { root.set-text-align(2); } }
                }
            }

            VerticalLayout {
                visible: root.is-frame;
                spacing: Theme.space-2;

                Divider {}

                Text {
                    text: "Auto layout";
                    color: Theme.text-muted;
                    font-size: Theme.font-xs;
                }
                HorizontalLayout {
                    spacing: Theme.space-1;
                    ActionButton { horizontal-stretch: 1; text: "None"; checked: root.layout-mode == 0; clicked => { root.set-layout-mode(0); } }
                    ActionButton { horizontal-stretch: 1; text: "Flex"; checked: root.layout-mode == 1; clicked => { root.set-layout-mode(1); } }
                }
                // Направление, сетка выравнивания и распределение — только при Flex.
                VerticalLayout {
                    visible: root.layout-mode == 1;
                    spacing: Theme.space-2;

                    HorizontalLayout {
                        spacing: Theme.space-1;
                        ActionButton { horizontal-stretch: 1; text: "Row"; checked: root.sel-layout-direction == 0; clicked => { root.set-layout-direction(0); } }
                        ActionButton { horizontal-stretch: 1; text: "Column"; checked: root.sel-layout-direction == 1; clicked => { root.set-layout-direction(1); } }
                    }
                    // Сетка 3×3: строки = выравнивание поперёк оси (align),
                    // столбцы = распределение вдоль оси (justify: Min/Center/Max).
                    VerticalLayout {
                        spacing: Theme.space-1;
                        for r in [0, 1, 2] : HorizontalLayout {
                            spacing: Theme.space-1;
                            for c in [0, 1, 2] : ActionButton {
                                horizontal-stretch: 1;
                                height: 22px;
                                text: "•";
                                checked: root.sel-layout-align == r && root.sel-layout-justify == c;
                                clicked => {
                                    root.set-layout-align(r);
                                    root.set-layout-justify(c);
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-1;
                        ActionButton {
                            horizontal-stretch: 1;
                            text: "⇄ Space between";
                            checked: root.sel-layout-justify == 3;
                            clicked => { root.set-layout-justify(3); }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-1;
                        NumberField {
                            horizontal-stretch: 1;
                            label: "Gap";
                            value: root.sel-layout-gap;
                            edited(t) => { root.live-layout-gap(t); }
                            set-value(t) => { root.live-layout-gap(t); root.commit-field(13); }
                            scrubbed(d) => { root.scrub-layout-gap(d); }
                        }
                        NumberField {
                            horizontal-stretch: 1;
                            label: "Pad";
                            value: root.sel-layout-padding;
                            edited(t) => { root.live-layout-padding(t); }
                            set-value(t) => { root.live-layout-padding(t); root.commit-field(14); }
                            scrubbed(d) => { root.scrub-layout-padding(d); }
                        }
                    }
                }
            }

            Divider {}

            Text {
                text: "Appearance";
                color: Theme.text-muted;
                font-size: Theme.font-xs;
            }
            NumberField {
                label: "%";
                value: root.sel-opacity-text;
                step: 1.0;
                edited(t) => { root.live-opacity(t); }
                set-value(t) => { root.live-opacity(t); root.commit-field(5); }
                scrubbed(d) => { root.scrub-delta(5, d); }
            }
            Text {
                text: "Corner radius";
                color: Theme.text-muted;
                font-size: Theme.font-xs;
                vertical-alignment: center;
            }
            // Свернутое состояние: одно поле R + кнопка раскрытия 4 углов.
            NumberField {
                visible: !root.sel-corner-expanded;
                label: "R";
                value: root.sel-corner-text;
                tooltip-hint: "Value, expression or % of smaller side";
                edited(t) => { root.live-corner-uniform(t); }
                set-value(t) => { root.live-corner-uniform(t); root.commit-field(15); }
                scrubbed(d) => { root.scrub-corner-uniform(d); }
            }
            // Развернутое состояние: 4 угла TL/TR/BR/BL.
            VerticalLayout {
                visible: root.sel-corner-expanded;
                spacing: Theme.space-1;
                HorizontalLayout {
                    spacing: Theme.space-1;
                    NumberField {
                        horizontal-stretch: 1;
                        label: "TL";
                        value: root.sel-corner-tl-text;
                        edited(t) => { root.live-corner(0, t); }
                        set-value(t) => { root.live-corner(0, t); root.commit-field(9); }
                        scrubbed(d) => { root.scrub-delta(7, d); }
                    }
                    NumberField {
                        horizontal-stretch: 1;
                        label: "TR";
                        value: root.sel-corner-tr-text;
                        edited(t) => { root.live-corner(1, t); }
                        set-value(t) => { root.live-corner(1, t); root.commit-field(10); }
                        scrubbed(d) => { root.scrub-delta(8, d); }
                    }
                }
                HorizontalLayout {
                    spacing: Theme.space-1;
                    NumberField {
                        horizontal-stretch: 1;
                        label: "BR";
                        value: root.sel-corner-br-text;
                        edited(t) => { root.live-corner(2, t); }
                        set-value(t) => { root.live-corner(2, t); root.commit-field(11); }
                        scrubbed(d) => { root.scrub-delta(9, d); }
                    }
                    NumberField {
                        horizontal-stretch: 1;
                        label: "BL";
                        value: root.sel-corner-bl-text;
                        edited(t) => { root.live-corner(3, t); }
                        set-value(t) => { root.live-corner(3, t); root.commit-field(12); }
                        scrubbed(d) => { root.scrub-delta(10, d); }
                    }
                }
            }
            // Кнопка-переключатель свёрнутого/развёрнутого вида.
            Rectangle {
                height: 24px;
                width: 100%;
                border-radius: Theme.radius-sm;
                background: expand-touch.pressed ? Theme.surface-raised : Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                expand-touch := TouchArea {
                    clicked => { root.toggle-corner-expand(); }
                    Tooltip { text: @markdown("Switch to 4-corner editing"); }
                    Text {
                        text: root.sel-corner-expanded ? "▾ collapse" : "▸ corners";
                        color: Theme.text-muted;
                        font-size: Theme.font-xs;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Divider {}

            Text {
                text: "Fill";
                color: Theme.text-muted;
                font-size: Theme.font-xs;
            }
            HorizontalLayout {
                spacing: Theme.space-2;
                Rectangle {
                    width: 30px;
                    height: 30px;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.border-strong;
                    background: root.sel-fill-preview;
                    touch := TouchArea {
                        clicked => { root.open-picker(); }
                    }
                }
                Field {
                    horizontal-stretch: 1;
                    text: root.sel-fill;
                    edited(t) => { root.live-fill(t); }
                    accepted(t) => { root.live-fill(t); }
                }
                Rectangle {
                    width: 30px;
                    height: 30px;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.border-strong;
                    background: touch.pressed ? Theme.surface-raised : Theme.surface;
                    dots-touch := TouchArea {
                        clicked => { root.open-picker(); }
                        Text {
                            text: "⋯";
                            color: Theme.text;
                            font-size: Theme.font-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Divider {}

            Text {
                text: "Stroke";
                color: Theme.text-muted;
                font-size: Theme.font-xs;
            }
            HorizontalLayout {
                spacing: Theme.space-2;
                Rectangle {
                    width: 30px;
                    height: 30px;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.border-strong;
                    background: root.sel-stroke-preview;
                    stroke-touch := TouchArea {
                        clicked => { root.open-stroke-picker(); }
                    }
                }
                Field {
                    horizontal-stretch: 1;
                    text: root.sel-stroke;
                    edited(t) => { root.live-stroke(t); }
                    accepted(t) => { root.live-stroke(t); }
                }
                Rectangle {
                    width: 30px;
                    height: 30px;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: root.sel-stroke-dash ? Theme.accent : Theme.border-strong;
                    background: stroke-dots-touch.pressed ? Theme.surface-raised : Theme.surface;
                    stroke-dots-touch := TouchArea {
                        clicked => { root.toggle-stroke-dash(); }
                        Text {
                            text: "┅";
                            color: Theme.text;
                            font-size: Theme.font-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            NumberField {
                label: "W";
                value: root.sel-stroke-width-text;
                step: 0.5;
                edited(t) => { root.live-stroke-width(t); }
                set-value(t) => { root.live-stroke-width(t); root.commit-field(8); }
                scrubbed(d) => { root.scrub-delta(6, d); }
            }
        }

        Text {
            text: root.sel-hint != "" ? root.sel-hint : "Select a node";
            color: Theme.text-faint;
            font-size: Theme.font-sm;
            visible: !root.has-selection;
        }
    }
}
