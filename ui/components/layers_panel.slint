import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export struct LayerItem {
    id: int,
    name: string,
    depth: int,
}

// Дерево слоёв (список внутри Bento-карточки). Стиль — только здесь.
// id — индекс слота NodeKey (младшие 32 бита as_ffi); список пересобирается
// на каждую ревизию, поэтому потеря version-бита безопасна.
export component LayersPanel inherits ListView {
    in-out property <[LayerItem]> layers;
    in-out property <int> selected-layer: -1;

    callback select-layer(int);

    for item in root.layers : Rectangle {
        height: 28px;
        border-radius: Theme.radius-sm;
        background: root.selected-layer == item.id ? Theme.selection : (touch.pressed ? Theme.surface-raised : transparent);
        touch := TouchArea {
            clicked => { root.select-layer(item.id); }
            Text {
                text: item.name;
                color: root.selected-layer == item.id ? Theme.text : Theme.text-muted;
                font-size: Theme.font-sm;
                vertical-alignment: center;
                x: Theme.space-2 + (item.depth * 10px);
            }
        }
    }
}