import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export struct LayerItem {
    id: int,
    name: string,
    depth: int,
    selected: bool,
}

// Дерево слоёв (список внутри Bento-карточки). Стиль — только здесь.
// id — индекс слота NodeKey (младшие 32 бита as_ffi); список пересобирается
// на каждую ревизию, поэтому потеря version-бита безопасна.
// Ctrl+клик — переключение узла, Shift+клик — диапазон от якоря.
// Drag как в Figma: строки однородной высоты 28px. Во время перетаскивания
// мышь захвачена исходной строкой (touch.mouse-y может выходить за её границы),
// поэтому зона дропа вычисляется по смещению от неё: target_idx = row + y/28,
// а зона — по локальному y внутри целевой строки (верх/центр/низ).
// Зона 0/2 — вставка до/после target (тот же уровень), зона 1 — вложение
// внутрь target. Индикатор: синяя рамка (вложение) / линия (вставка).
// Переименование: двойной клик по строке открывает инлайн-поле (commit по
// Enter/потере фокуса).
export component LayersPanel inherits ListView {
    in-out property <[LayerItem]> layers;
    // Какой слой переименовывается (инлайн-поле); -1 — никто. Управляется
    // извне: двойной клик сообщает start-rename, готовность — rename-done.
    in property <int> editing-id: -1;
    // Состояние drag&drop: целевая строка и зона (0=выше, 1=внутрь, 2=ниже).
    in-out property <int> drop-target: -1;
    in-out property <int> drop-zone: 0;
    property <bool> dragging: false;

    callback select-layer-mod(int, bool, bool);
    callback drag-start(int);
    callback drop-layer(int, int);
    callback rename-layer(int, string);
    callback rename-done();
    // ПКМ отпущена по строке слоя: id строки + локальный y панели.
    callback context-menu(int, float);
    callback start-rename(int);

    for item[row_idx] in root.layers : Rectangle {
        height: 28px;
        border-radius: Theme.radius-sm;
        border-width: (root.drop-target == item.id && root.drop-zone == 1) ? 1px : 0px;
        border-color: Theme.accent;
        background: item.selected ? Theme.selection : (touch.pressed ? Theme.surface-raised : transparent);
        touch := TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    if (event.button == PointerEventButton.left) {
                        root.dragging = true;
                        root.drop-target = -1;
                        root.drag-start(item.id);
                    }
                }
                if (event.kind == PointerEventKind.up) {
                    if (event.button == PointerEventButton.left) {
                        // Целевая строка и зона — из смещения от захваченной строки.
                        let y = touch.mouse-y / 1px;
                        let off = floor(y / 28.0);
                        let target_idx = row_idx + off;
                        let local_y = y - off * 28.0;
                        let zone = local_y < 7.0 ? 0 : (local_y > 21.0 ? 2 : 1);
                        let idx = min(max(target_idx, 0), root.layers.length - 1);
                        if (idx >= 0) {
                            root.drop-layer(root.layers[idx].id, zone);
                        }
                        root.dragging = false;
                        root.drop-target = -1;
                        root.select-layer-mod(item.id, event.modifiers.control, event.modifiers.shift);
                    } else if (event.button == PointerEventButton.right) {
                        root.context-menu(item.id, touch.mouse-y / 1px);
                    }
                }
            }
            moved => {
                // При захваченной мыши hover-цель вычисляем по смещению.
                if (root.dragging) {
                    let y = touch.mouse-y / 1px;
                    let off = floor(y / 28.0);
                    let target_idx = row_idx + off;
                    let local_y = y - off * 28.0;
                    let zone = local_y < 7.0 ? 0 : (local_y > 21.0 ? 2 : 1);
                    if (target_idx >= 0 && target_idx < root.layers.length) {
                        root.drop-zone = zone;
                        root.drop-target = root.layers[target_idx].id;
                    } else {
                        root.drop-target = -1;
                    }
                }
            }
            double-clicked => {
                root.start-rename(item.id);
            }
            if root.editing-id != item.id : Text {
                text: item.name;
                color: item.selected ? Theme.text : Theme.text-muted;
                font-size: Theme.font-sm;
                vertical-alignment: center;
                x: Theme.space-2 + (item.depth * 10px);
            }
            if root.editing-id == item.id : Rectangle {
                x: Theme.space-1 + (item.depth * 10px);
                width: parent.width - Theme.space-2 - (item.depth * 10px);
                height: parent.height - Theme.space-1;
                y: 2px;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.accent;
                background: Theme.bg;
                rename-input := TextInput {
                    text: item.name;
                    color: Theme.text;
                    font-size: Theme.font-sm;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                    x: Theme.space-2;
                    width: parent.width - Theme.space-4;
                    init => { self.focus(); }
                    accepted => {
                        root.rename-layer(item.id, self.text);
                        root.rename-done();
                    }
                    edited => { }
                }
            }
            // Индикатор вставки: линия сверху (zone 0) или снизу (zone 2).
            if root.dragging && root.drop-target == item.id && root.drop-zone != 1 : Rectangle {
                visible: true;
                x: 2px;
                width: parent.width - 4px;
                height: 2px;
                y: root.drop-zone == 0 ? 0px : (parent.height - 2px);
                background: Theme.accent;
                border-radius: 1px;
            }
        }
    }
}