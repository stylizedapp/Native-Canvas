import { ActionButton, Divider, Field, NumberField, SectionHeader } from "ds.slint";
import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";

export struct ShortcutEditRow {
    action: string,
    combo: string,
}

// Диалог настроек: тема, сетка/снап, редактирование хоткеев. Оверлей.
// Комбинация хоткея вводится текстом ("Ctrl+Shift+Z") и парсится в Rust;
// дефолтная таблица живёт в src/engine/shortcuts.rs.
export component SettingsPanel inherits Rectangle {
    in-out property <bool> open: false;
    in property <bool> dark: false;
    in property <bool> grid: false;
    in property <bool> snap: false;
    in property <string> step: "";
    in property <string> render-max-dim: "1920";
    in property <[ShortcutEditRow]> shortcut-rows;

    callback close();
    callback set-dark(bool);
    callback set-grid(bool);
    callback set-snap(bool);
    callback set-step(string);
    callback set-render-max-dim(string);
    callback set-shortcut(string, string);
    callback commit-shortcut(string, string);
    callback reset-shortcuts();

    visible: root.open;
    background: transparent;

    Rectangle {
        width: 100%;
        height: 100%;
        background: #00000066;
        TouchArea {
            clicked => { root.close(); }
        }
    }

    Rectangle {
        x: (parent.width - 480px) / 2;
        y: (parent.height - 540px) / 2;
        width: 480px;
        height: 540px;
        background: Theme.surface-raised;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border-strong;

        VerticalLayout {
            padding: Theme.space-3;
            spacing: Theme.space-2;

            HorizontalLayout {
                spacing: Theme.space-2;
                Text {
                    text: "Settings";
                    color: Theme.text;
                    font-weight: 700;
                    font-size: Theme.font-md;
                    vertical-alignment: center;
                }
                HorizontalLayout { horizontal-stretch: 1; }
                Rectangle {
                    width: 26px;
                    height: 26px;
                    border-radius: Theme.radius-sm;
                    background: touch.pressed ? Theme.surface : Theme.surface-raised;
                    touch := TouchArea {
                        clicked => { root.close(); }
                        Text {
                            text: "✕";
                            color: Theme.text-muted;
                            font-size: Theme.font-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: Theme.space-2;

                    SectionHeader { caption: "Appearance"; }
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        ActionButton { horizontal-stretch: 1; text: "Dark"; checked: root.dark; clicked => { root.set-dark(true); } }
                        ActionButton { horizontal-stretch: 1; text: "Light"; checked: !root.dark; clicked => { root.set-dark(false); } }
                    }

                    Divider {}

                    SectionHeader { caption: "Canvas"; }
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        ActionButton { horizontal-stretch: 1; text: "Grid"; checked: root.grid; clicked => { root.set-grid(!root.grid); } }
                        ActionButton { horizontal-stretch: 1; text: "Snap"; checked: root.snap; clicked => { root.set-snap(!root.snap); } }
                    }
                    NumberField {
                        label: "Step";
                        value: root.step;
                        edited(t) => { root.set-step(t); }
                        set-value(t) => { root.set-step(t); }
                    }
                    NumberField {
                        label: "Render dim (px)";
                        value: root.render-max-dim;
                        edited(t) => { root.set-render-max-dim(t); }
                        set-value(t) => { root.set-render-max-dim(t); }
                    }

                    Divider {}

                    SectionHeader { caption: "Keyboard shortcuts"; }
                    for row in root.shortcut-rows : HorizontalLayout {
                        height: 30px;
                        spacing: Theme.space-2;
                        Text {
                            width: 130px;
                            text: row.action;
                            color: Theme.text;
                            font-size: Theme.font-sm;
                            vertical-alignment: center;
                        }
                        Field {
                            horizontal-stretch: 1;
                            text: row.combo;
                            edited(t) => { root.set-shortcut(row.action, t); }
                            accepted(t) => { root.commit-shortcut(row.action, t); }
                        }
                    }
                    ActionButton { text: "Reset shortcuts"; clicked => { root.reset-shortcuts(); } }
                }
            }
        }
    }
}