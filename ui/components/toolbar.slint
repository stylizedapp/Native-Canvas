import { Button } from "std-widgets.slint";
import { Theme } from "../theme.slint";

// Панель инструментов: инструменты, история, файлы, сетка/снап, дебагер.
export component Toolbar {
    in-out property <string> active-tool: "select";
    in-out property <bool> grid-on: true;
    in-out property <bool> snap-on: true;
    in-out property <bool> debug-on: false;

    callback tool-selected(string);
    callback undo();
    callback redo();
    callback delete-selection();
    callback new-doc();
    callback open-doc();
    callback save-doc();
    callback toggle-grid();
    callback toggle-snap();
    callback toggle-debug();

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        Text { text: "Tools"; color: Theme.heading; font-weight: 700; }

        HorizontalLayout {
            spacing: 4px;
            Button {
                text: "V";
                checked: root.active-tool == "select";
                clicked => { root.tool-selected("select"); }
            }
            Button {
                text: "H";
                checked: root.active-tool == "pan";
                clicked => { root.tool-selected("pan"); }
            }
        }
        HorizontalLayout {
            spacing: 4px;
            Button {
                text: "Rect";
                checked: root.active-tool == "rectangle";
                clicked => { root.tool-selected("rectangle"); }
            }
            Button {
                text: "Ell";
                checked: root.active-tool == "ellipse";
                clicked => { root.tool-selected("ellipse"); }
            }
        }
        HorizontalLayout {
            spacing: 4px;
            Button {
                text: "Line";
                checked: root.active-tool == "line";
                clicked => { root.tool-selected("line"); }
            }
            Button {
                text: "Frame";
                checked: root.active-tool == "frame";
                clicked => { root.tool-selected("frame"); }
            }
        }

        HorizontalLayout {
            spacing: 4px;
            Button { text: "Undo"; clicked => { root.undo(); } }
            Button { text: "Redo"; clicked => { root.redo(); } }
        }
        Button { text: "Delete"; clicked => { root.delete-selection(); } }

        Rectangle { height: 1px; background: Theme.border; }

        HorizontalLayout {
            spacing: 4px;
            Button { text: "New"; clicked => { root.new-doc(); } }
            Button { text: "Open"; clicked => { root.open-doc(); } }
            Button { text: "Save"; clicked => { root.save-doc(); } }
        }

        HorizontalLayout {
            spacing: 4px;
            Button {
                text: "Grid";
                checked: root.grid-on;
                clicked => { root.toggle-grid(); }
            }
            Button {
                text: "Snap";
                checked: root.snap-on;
                clicked => { root.toggle-snap(); }
            }
        }
        Button {
            text: "Debug";
            checked: root.debug-on;
            clicked => { root.toggle-debug(); }
        }
    }
}