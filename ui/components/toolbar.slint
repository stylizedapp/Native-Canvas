import { ToolButton } from "ds.slint";
import { Theme } from "../theme.slint";

// Плавающая панель инструментов («пилюля») — вешается поверх канваса
// в CanvasView, по центру сверху.
export component Toolbar inherits Rectangle {
    in-out property <string> active-tool: "select";

    callback tool-selected(string);

    width: 376px;
    height: 44px;
    background: Theme.surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding: Theme.space-1;
        spacing: Theme.space-1;
        ToolButton { horizontal-stretch: 1; text: "V"; active: root.active-tool == "select"; clicked => { root.tool-selected("select"); } }
        ToolButton { horizontal-stretch: 1; text: "H"; active: root.active-tool == "pan"; clicked => { root.tool-selected("pan"); } }
        ToolButton { horizontal-stretch: 1; text: "Rect"; active: root.active-tool == "rectangle"; clicked => { root.tool-selected("rectangle"); } }
        ToolButton { horizontal-stretch: 1; text: "Ell"; active: root.active-tool == "ellipse"; clicked => { root.tool-selected("ellipse"); } }
        ToolButton { horizontal-stretch: 1; text: "Line"; active: root.active-tool == "line"; clicked => { root.tool-selected("line"); } }
        ToolButton { horizontal-stretch: 1; text: "Frame"; active: root.active-tool == "frame"; clicked => { root.tool-selected("frame"); } }
    }
}
