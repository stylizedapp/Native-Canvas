import { Theme } from "theme.slint";
import { BentoColumn, BentoGrid, Panel, SectionHeader, ActionButton, NumberField, TopBar } from "components/ds.slint";
import { LayerItem, LayersPanel } from "components/layers_panel.slint";
import { Inspector } from "components/inspector.slint";
import { CanvasView } from "components/canvas_view.slint";

// Корневой компонент: Bento-воркспейс. Сцена (Rust) общается с UI только
// через типизированные свойства и колбэки (см. AppWindow).
export component AppWindow inherits Window {
    title: "NativeCanvas";
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.bg;

    in-out property <image> canvas-texture;
    in-out property <string> zoom-text: "100%";
    in-out property <string> fps-text: "FPS --";
    in-out property <string> status-text: "Ready";
    in-out property <string> tool: "select";
    in-out property <[LayerItem]> layers;
    in-out property <int> selected-layer: -1;
    // Дебагер
    in-out property <bool> debug-show: false;
    in-out property <string> debug-text: "";
    // Фактический размер области холста (приходит из CanvasView).
    in-out property <float> canvas-width: 1;
    in-out property <float> canvas-height: 1;
    // Сетка / снап
    in-out property <bool> grid-on: true;
    in-out property <bool> snap-on: true;
    in-out property <string> grid-step-text: "8";

    // Инспектор выделенного узла (тексты полей — строки, управляются из Rust).
    in-out property <bool> has-selection: false;
    in-out property <string> sel-name: "";
    in-out property <string> sel-x-text: "";
    in-out property <string> sel-y-text: "";
    in-out property <string> sel-w-text: "";
    in-out property <string> sel-h-text: "";
    in-out property <string> sel-opacity-text: "";
    in-out property <string> sel-fill: "";

    // Callbacks ядра
    callback tool-changed(string);
    callback undo();
    callback redo();
    callback delete-selection();
    callback new-doc();
    callback save-doc();
    callback open-doc();
    callback pointer-down(int, float, float);
    callback pointer-move(int, float, float);
    callback pointer-up(int, float, float);
    callback scroll(float, float, float);
    callback select-layer(int);
    callback toggle-grid();
    callback toggle-snap();
    callback toggle-debug();
    callback set-grid-step(string);
    callback reset-view();
    callback canvas-resized();
    // Инспектор
    callback set-name(string);
    callback set-x(string);
    callback set-y(string);
    callback set-w(string);
    callback set-h(string);
    callback set-opacity(string);
    callback set-fill(string);

    VerticalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-3;

        TopBar {
            zoom: root.zoom-text;
            fps: root.fps-text;
            status: root.status-text;
        }

        BentoGrid {
            // ===== Левая колонка: слои + дебагер =====
            BentoColumn {
                width: 232px;

                Panel {
                    SectionHeader { caption: "Layers"; }
                    LayersPanel {
                        vertical-stretch: 1;
                        layers: root.layers;
                        selected-layer: root.selected-layer;
                        select-layer(id) => { root.select-layer(id); }
                    }
                }

                Panel {
                    pad: Theme.space-2;
                    ActionButton { text: "Debug"; checked: root.debug-show; clicked => { root.toggle-debug(); } }
                }
            }

            // ===== Центр: viewport холста (инструменты плавают поверх) =====
            CanvasView {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                canvas-texture: root.canvas-texture;
                debug-show: root.debug-show;
                debug-text: root.debug-text;
                active-tool: root.tool;
                canvas-size-changed(w, h) => {
                    root.canvas-width = w;
                    root.canvas-height = h;
                    root.canvas-resized();
                }
                pointer-down(b, x, y) => { root.pointer-down(b, x, y); }
                pointer-move(b, x, y) => { root.pointer-move(b, x, y); }
                pointer-up(b, x, y) => { root.pointer-up(b, x, y); }
                scroll(d, x, y) => { root.scroll(d, x, y); }
                tool-selected(t) => { root.tool-changed(t); }
            }

            // ===== Правая колонка: инспектор + настройки =====
            BentoColumn {
                width: 280px;

                Inspector {
                    has-selection: root.has-selection;
                    sel-name: root.sel-name;
                    sel-x-text: root.sel-x-text;
                    sel-y-text: root.sel-y-text;
                    sel-w-text: root.sel-w-text;
                    sel-h-text: root.sel-h-text;
                    sel-opacity-text: root.sel-opacity-text;
                    sel-fill: root.sel-fill;
                    set-name(t) => { root.set-name(t); }
                    set-x(t) => { root.set-x(t); }
                    set-y(t) => { root.set-y(t); }
                    set-w(t) => { root.set-w(t); }
                    set-h(t) => { root.set-h(t); }
                    set-opacity(t) => { root.set-opacity(t); }
                    set-fill(t) => { root.set-fill(t); }
                }

                Panel {
                    SectionHeader { caption: "Settings"; }
                    HorizontalLayout {
                        spacing: Theme.space-1;
                        ActionButton { horizontal-stretch: 1; text: "Grid"; checked: root.grid-on; clicked => { root.toggle-grid(); } }
                        ActionButton { horizontal-stretch: 1; text: "Snap"; checked: root.snap-on; clicked => { root.toggle-snap(); } }
                    }
                    NumberField {
                        label: "Step";
                        value: root.grid-step-text;
                        set-value(t) => { root.set-grid-step(t); }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-1;
                        ActionButton { horizontal-stretch: 1; text: "Reset view"; clicked => { root.reset-view(); } }
                        ActionButton { horizontal-stretch: 1; text: "Delete"; clicked => { root.delete-selection(); } }
                    }
                }
            }
        }
    }
}
