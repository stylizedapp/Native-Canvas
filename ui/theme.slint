// Централизованная тема UI. Изменение стиля приложения = правка этого файла.
export global Theme {
    in-out property <brush> bg-canvas: #1e1e1e;
    in-out property <brush> bg-panel: #252526;
    in-out property <brush> bg-topbar: #181818;
    in-out property <brush> border: #3a3a3a;
    in-out property <brush> heading: #9cdcfe;
    in-out property <brush> text: #d4d4d4;
    in-out property <brush> text-dim: #888888;
    in-out property <brush> accent: #264f78;
    in-out property <brush> ok: #00ff66;
    in-out property <brush> debug-bg: #1c1c1cd8;
}