// Централизованная дизайн-система "Bento".
// Все цвета/отступы/радиусы/шрифты — только здесь. Правка токенов = новый стиль.
// Тема: `dark` переключает обе палитры (Obsidian и светлая Slate).
export global Theme {
    // --- Флаг темы (Dark / Light) ---
    in-out property <bool> dark: false;

    // --- Surfaces ---
    in-out property <brush> bg: self.dark ? #0d0e12 : #eef1f6;
    in-out property <brush> surface: self.dark ? #161820 : #ffffff;
    in-out property <brush> surface-raised: self.dark ? #202330 : #f6f7fb;
    in-out property <brush> border: self.dark ? #2a2e3d : #d8dde7;
    in-out property <brush> border-strong: self.dark ? #3f455c : #b6bdcd;

    // --- Text ---
    in-out property <brush> text: self.dark ? #f7f9fc : #15171d;
    in-out property <brush> text-muted: self.dark ? #8d95a8 : #4b5467;
    in-out property <brush> text-faint: self.dark ? #52586b : #7c8498;

    // --- Accent / states ---
    in-out property <brush> accent: #3b71fe;
    in-out property <brush> accent-hover: #5685ff;
    in-out property <brush> accent-contrast: #ffffff;
    in-out property <brush> selection: self.dark ? #1a2d54 : #d5e0ff;
    in-out property <brush> danger: #ff453a;

    // --- Canvas ---
    in-out property <brush> canvas-bg: self.dark ? #090a0d : #e4e8ef;

    // --- Spacing (4pt сетка) ---
    in-out property <length> space-0: 0px;
    in-out property <length> space-1: 4px;
    in-out property <length> space-2: 8px;
    in-out property <length> space-3: 12px;
    in-out property <length> space-4: 16px;
    in-out property <length> space-5: 24px;

    // --- Radii ---
    in-out property <length> radius-sm: 8px;
    in-out property <length> radius-md: 12px;
    in-out property <length> radius-lg: 16px;

    // --- Typography ---
    in-out property <length> font-xs: 11px;
    in-out property <length> font-sm: 12px;
    in-out property <length> font-md: 14px;
    in-out property <length> font-lg: 16px;
}